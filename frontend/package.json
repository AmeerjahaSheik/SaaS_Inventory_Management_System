  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"try{const fs=require('fs'),p=require('path'),d='node_modules/.bin';if(fs.existsSync(d)){fs.readdirSync(d).forEach(f=>fs.chmodSync(p.join(d,f),0o755));}}catch(e){}\"",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview"
  },
